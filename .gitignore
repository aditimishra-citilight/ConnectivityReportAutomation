node_modules/
*.xlsx
*.log
.claude/

# Local config holds real credentials — keep it out of the repo.
# Use cities.config.example.js as the template.
cities.config.js

# Raw API captures contain login bodies + session cookies — keep local only.
captures/

# Mail credentials (Gmail App Password). Templates: mail.env.example.bat (Windows),
# mail.env.example.sh (Linux).
mail.env.bat
mail.env.sh

# Real recipient addresses. Use recipients.example.txt as the template.
recipients.txt
recipients-cc.txt
recipients-watch.txt

# Generated output: workbooks, run snapshots, sent-email previews.
Reports/
# ...and any archive of it (backups people zip up by hand).
*.zip

# Shareable copy of the docs, rebuilt from docs\ whenever it is needed.
# Not tracked: two copies of the same text would drift apart.
KT-Share/
